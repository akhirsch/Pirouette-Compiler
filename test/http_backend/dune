; A participant is its own executable because the backend makes a process one
; location; the tests below only start them and collect the results.

(executables
 (names send_participant choose_participant)
 (modules send_participant choose_participant ring)
 (libraries backend))

; Note: Test cases must run sequentially (`-runner sequential`).
; That's because each test must ensure the free ports it finds are actually
; available for its participants and that `Lwt_main.run` doesn't block forever.
; Further, `(locks ports)` ensures only one action that uses ports runs at a time.

(tests
 (names test_http_backend)
 (modules test_http_backend)
 (libraries ounit2 unix lwt.unix)
 (locks ports)
 (deps send_participant.exe choose_participant.exe)
 (action
  (run %{test} -runner sequential)))
