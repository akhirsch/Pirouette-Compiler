; Manual assembly of the complete OCaml AST
(executable
 (name full_test)
 (modules full_test)
 (libraries ppxlib pirc.netir pirc.eio_domains_backend)
 (preprocess
  (pps ppxlib.metaquot)))

; Generate OCaml source from full_test
(rule
 (target generated_eio.ml)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:full_test.exe}))))

; Compile and execute the generated program
(test
 (name generated_eio)
 (modules generated_eio)
 (libraries eio eio_main))

; Automatic choreography assembly
(executable
 (name choreotest)
 (modules choreotest)
 (libraries ppxlib pirc.netir pirc.eio_domains_backend)
 (preprocess
  (pps ppxlib.metaquot)))

; Generate OCaml source from choreotest
(rule
 (target generated_choreo.ml)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:choreotest.exe}))))

; Compile and execute the generated choreography
(test
 (name generated_choreo)
 (modules generated_choreo)
 (libraries eio eio_main))

